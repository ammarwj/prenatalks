# Variabel untuk docker-compose.prod.yml — salin ke `.env` di /opt/prenatalks.
# Ini BUKAN .env Laravel (yang itu ada di api/.env).

# Kredensial Postgres container (harus sama dengan DB_* di api/.env)
DB_DATABASE=prenatalks
DB_USERNAME=prenatalks
DB_PASSWORD=GANTI_PASSWORD_KUAT_DI_SINI

# Port yang dibuka ke 127.0.0.1 di host (dipilih agar tidak bentrok stack lain)
WEB_PORT=3003
API_PORT=8003
DB_PORT_HOST=5430

# Dibaca saat BUILD image web — ubah nilainya = wajib build ulang
NEXT_PUBLIC_API_URL=https://api.prenatalks.id/api/v1
NEXT_PUBLIC_SITE_URL=https://prenatalks.id

# Runtime web
AUTH_COOKIE_NAME=pt_refresh
